<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the pure C# engine and its NUnit tests WITHOUT Unity:  dotnet test Tools/CoreTests
    It compiles the very same source files Unity compiles, restricted to C# 9 to match Unity 6.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>MetroSort</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Assets\MetroSort\Scripts\Core\**\*.cs" LinkBase="Core" />
    <Compile Include="..\..\Assets\MetroSort\Tests\EditMode\**\*.cs" LinkBase="Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
